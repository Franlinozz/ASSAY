# Assay Caddy blocks (P8: web :3100 + docs :3101 + api :8422) — additive to the shared box.
# Copy into /etc/caddy/Caddyfile, then: caddy validate && systemctl reload caddy

assayed.xyz, www.assayed.xyz {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.assayed.xyz https://rpc.xlayer.tech; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Docs (Fumadocs, basePath /docs) on :3101 — matched first, prefix preserved.
	handle /docs* {
		reverse_proxy 127.0.0.1:3101
	}
	# The public Assay Office (Next 15) on :3100.
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

api.assayed.xyz {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Assay MCP runs on 8422 (8402 was already taken on this box).
	reverse_proxy 127.0.0.1:8422
	encode gzip
}
