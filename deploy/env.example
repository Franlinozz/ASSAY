# Assay MCP — production environment.
# Real file lives at /etc/assay/env on the VPS (chmod 600, root only). NEVER commit real values.

# ── payment + provider mode ──
ASY_PAYMENT_MODE=okx          # dev = documented handshake, no settlement; okx = real x402 via OKX Facilitator
ASY_PROVIDER_MODE=live        # fake = deterministic offline; live = Claude/DeepSeek/OpenAI
ASY_PORT=8422                 # 8402 was already taken on this box
ASY_BASE_URL=https://api.assayed.xyz

# ── chain + seal ──
ASY_CHAIN_ID=196              # X Layer mainnet
ASY_TREASURY=0x...            # USDT settlement recipient (the deployer address is fine)
ASY_REGISTRY=0x...            # AssayRegistry on X Layer mainnet (from scripts/deploy.ts mainnet)
ASY_SEALER_KEY=0x...          # sealer private key == deployer PK (batch anchoring keeps gas trivial)
ASY_ANCHOR_INTERVAL_MIN=30
ASY_ANCHOR_ALERT_HOURS=2
ASY_MIN_FREE_DISK_MB=256

# ── storage ──
ASY_DATA_DIR=/var/lib/assay
ASY_SIGNING_SECRET=...        # random 32-byte hex for HMAC file tokens: openssl rand -hex 32

# ── OKX x402 facilitator (settlement) ──
ASY_OKX_API_KEY=...
ASY_OKX_SECRET_KEY=...
ASY_OKX_PASSPHRASE=...
# ASY_OKX_BASE_URL=https://web3.okx.com/facilitator   # SDK default; set only if it changes

# ── providers (live) ──
ANTHROPIC_API_KEY=...
OPENAI_API_KEY=...
DEEPSEEK_API_KEY=...

# ── marketplace ──
ASY_AGENT_ID=...              # set after OKX.AI ASP registration (STEP 4)
