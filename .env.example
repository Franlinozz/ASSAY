# ─────────────────────────────────────────────────────────────
# Assay environment — copy to .env and fill in. NEVER commit .env.
# In production, load via systemd EnvironmentFile (guardrail #4).
# ─────────────────────────────────────────────────────────────

# Provider mode: `fake` (deterministic, zero-spend — DEFAULT for dev/tests/Playwright)
# or `live` (real LLM providers, one paid smoke per phase).
ASY_PROVIDER_MODE=fake

# Payment mode: `fake` (no x402 settlement, dev default) or `live` (x402 on X Layer).
ASY_PAYMENT_MODE=fake

# Treasury address that receives USDT settlements (x402 payTo).
ASY_TREASURY=

# Private key that signs EIP-712 seals and submits AssayRegistry anchors.
# Load from env only; never place a real key in the repo.
ASY_SEALER_KEY=

# Deployed AssayRegistry contract address.
ASY_REGISTRY=

# CAIP-2 chain id. X Layer mainnet = 196, testnet = 195.
ASY_CHAIN_ID=196

# Bearer token guarding admin/operator routes.
ASY_ADMIN_TOKEN=

# Public base URL of the deployed app (used for share links, signed URLs, listing).
ASY_BASE_URL=https://assayed.xyz

# ── LLM providers (used only when ASY_PROVIDER_MODE=live) ──
# Claude = critic + writer.
ANTHROPIC_API_KEY=
# DeepSeek = extraction / classification / JD decomposition.
DEEPSEEK_API_KEY=
# OpenAI = runtime failover.
OPENAI_API_KEY=
